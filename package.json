{
  "name": "@plasius/gpu-shader",
  "version": "0.1.0",
  "description": "Reflection-first WebGPU WGSL interfaces, CPU codecs, compatibility validation, style profiles, and qualification tooling",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "plasius-gpu-shader": "./dist/cli.js"
  },
  "files": [
    "dist",
    "matrices"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage .npm-cache-packcheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "pack:check": "node scripts/verify-public-package.cjs",
    "harness:fingerprint": "node scripts/fingerprint-trusted-harness.cjs .",
    "shader:matrix": "npm run build && node dist/cli.js validate-matrix --matrix matrices/stable-webgpu-2026-07-13.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "webgpu",
    "wgsl",
    "shader",
    "reflection",
    "gpu",
    "abi",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-shader.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-shader/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-shader#readme",
  "dependencies": {
    "wgsl_reflect": "1.5.0"
  },
  "optionalDependencies": {
    "playwright-core": "1.61.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
